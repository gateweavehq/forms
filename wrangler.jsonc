// Forms deploys from the repository root, as its siblings do, so that a "Deploy to Cloudflare"
// button can find this file there; the app itself lives in apps/web, which runs Wrangler and Vite
// against it.
{
	"$schema": "apps/web/node_modules/wrangler/config-schema.json",
	"name": "gateweave-forms",
	"main": "apps/web/src/server.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// Settings made in the dashboard stay through a deploy. Wrangler otherwise removes a plain-text
	// variable it does not find here, so the next push would quietly take away a setting.
	"keep_vars": true,
	// Only what the Worker writes itself is kept, and it writes the names of its own errors. An
	// invocation log holds each request, with its address (a response's id is in it) and the
	// metadata Cloudflare has about where it came from. A study that promises to store nothing
	// about who answered has to mean its logs too.
	"observability": { "enabled": true, "logs": { "invocation_logs": false } },
	"upload_source_maps": true,
	// Ceilings on the two addresses that need no secret: starting a response and storing a detached
	// answer. Each is counted per form, never per client: the Worker reads no network address.
	// A ceiling stops a flood from filling the tables; it cannot tell one sender from another,
	// which is the job of a rate-limiting rule at Cloudflare's edge (docs/architecture.md).
	// The numbers are per Cloudflare location and per minute. `namespace_id` only has to be
	// unique within the account.
	"ratelimits": [
		{ "name": "START_LIMIT", "namespace_id": "4770", "simple": { "limit": 120, "period": 60 } },
		{ "name": "DETACHED_LIMIT", "namespace_id": "4771", "simple": { "limit": 60, "period": 60 } }
	],
	// Responses: one row per response, one per answer, and the answers a form keeps apart.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gateweave-forms",
			"migrations_dir": "apps/web/migrations"
		}
	]
}
