// Forms deploys from the repository root, as its siblings do, so that a "Deploy to Cloudflare"
// button can find this file there; the app itself lives in apps/web, which runs Wrangler and Vite
// against it.
{
	"$schema": "apps/web/node_modules/wrangler/config-schema.json",
	"name": "gateweave-forms",
	"main": "apps/web/src/server.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// Settings made in the dashboard stay through a deploy. Wrangler otherwise removes a plain-text
	// variable it does not find here, so the next push would quietly take away a setting.
	"keep_vars": true,
	// Only what the Worker writes itself is kept, and it writes the names of its own errors. An
	// invocation log holds each request, with its address (a response's id is in it) and the
	// metadata Cloudflare has about where it came from. A study that promises to store nothing
	// about who answered has to mean its logs too.
	"observability": { "enabled": true, "logs": { "invocation_logs": false } },
	"upload_source_maps": true,
	// Ceilings on the two addresses that need no secret: starting a response and storing a detached
	// answer. Each is counted per form, never per client: the Worker reads no network address.
	// A ceiling stops a flood from filling the tables; it cannot tell one sender from another,
	// which is the job of a rate-limiting rule at Cloudflare's edge (docs/architecture.md).
	// The numbers are per Cloudflare location and per minute. `namespace_id` only has to be
	// unique within the account.
	// AUTH_LIMIT counts tries at signing in and signing up per email address tried, and tries at
	// changing a password per account: ten a minute is plenty for a person and little for
	// guessing at a password. AUTH_SENDER_LIMIT counts every request that signs in, signs up or
	// changes an account per network address it came from, so that one sender cannot go through
	// a list of addresses. It is the one place the Worker reads a network address: as the key
	// of this counter, for the accounts of people who run forms, never for a respondent, and it
	// is neither stored nor logged.
	"ratelimits": [
		{ "name": "START_LIMIT", "namespace_id": "4770", "simple": { "limit": 120, "period": 60 } },
		{ "name": "DETACHED_LIMIT", "namespace_id": "4771", "simple": { "limit": 60, "period": 60 } },
		{ "name": "AUTH_LIMIT", "namespace_id": "4774", "simple": { "limit": 10, "period": 60 } },
		{
			"name": "AUTH_SENDER_LIMIT",
			"namespace_id": "4776",
			"simple": { "limit": 30, "period": 60 }
		}
	],
	// Signs the sessions of the people who run forms. A deploy without it is refused.
	// Optional settings: BETTER_AUTH_URL, SIGN_UP_ALLOW, FORMS_EXAMPLES
	// (see apps/web/src/server/env.d.ts).
	"secrets": { "required": ["BETTER_AUTH_SECRET"] },
	// Responses: one row per response, one per answer, and the answers a form keeps apart.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gateweave-forms",
			"migrations_dir": "apps/web/migrations"
		}
	],
	// The top level is what a self-hoster deploys. Gateweave's own staging is the environment
	// below: a separate Worker with its own database, kept in the EU (the database was created
	// with the `eu` jurisdiction). Bindings are not inherited, so it repeats them.
	// Gateweave's deployments follow Track's convention: this public file names the environment,
	// its Worker, its custom domain and its database's id (the id of a resource, which grants
	// nothing), and nothing that names the account. The Cloudflare account id is the repository
	// variable CLOUDFLARE_ACCOUNT_ID and the API token a secret of the repository
	// (.github/workflows/deploy.yml); a zone is found by Cloudflare from the custom domain. The
	// top level has no `database_id` here: a self-hoster's is made on the first deploy, and
	// whatever Gateweave keeps for its own is kept outside this repository.
	"env": {
		"staging": {
			"name": "gateweave-forms-staging",
			"routes": [{ "pattern": "forms-staging.gateweave.com", "custom_domain": true }],
			"ratelimits": [
				{ "name": "START_LIMIT", "namespace_id": "4772", "simple": { "limit": 120, "period": 60 } },
				{
					"name": "DETACHED_LIMIT",
					"namespace_id": "4773",
					"simple": { "limit": 60, "period": 60 }
				},
				{ "name": "AUTH_LIMIT", "namespace_id": "4775", "simple": { "limit": 10, "period": 60 } },
				{
					"name": "AUTH_SENDER_LIMIT",
					"namespace_id": "4777",
					"simple": { "limit": 30, "period": 60 }
				}
			],
			"secrets": { "required": ["BETTER_AUTH_SECRET"] },
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "gateweave-forms-staging-eu",
					"database_id": "32435975-d9b0-4f40-a1f0-452d782f5da9",
					"migrations_dir": "apps/web/migrations"
				}
			]
		}
	}
}
