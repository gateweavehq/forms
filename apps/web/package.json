{
	"name": "@gateweave/forms-web",
	"version": "0.0.0",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 4770 --strictPort",
		"dev:setup": "pnpm db:migrate:local",
		"build": "vite build",
		"preview": "vite preview",
		"typegen": "wrangler types && tsr generate",
		"typecheck": "wrangler types && tsr generate && tsc && tsc -p test && tsc -p e2e",
		"test": "vitest run",
		"test:e2e": "vite build && playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
		"db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging --cwd ../..",
		"deploy:staging": "vite build --mode staging && wrangler deploy --cwd ../.."
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@gateweave/forms-schema": "workspace:*",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.5",
		"drizzle-orm": "catalog:",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.68.0",
		"@playwright/test": "1.65.0",
		"@tailwindcss/vite": "4.3.5",
		"@tanstack/router-cli": "1.168.0",
		"@types/node": "catalog:",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"drizzle-kit": "catalog:",
		"miniflare": "5.20261023.0-beta",
		"tailwindcss": "4.3.5",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}
