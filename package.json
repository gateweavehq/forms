{
	"name": "gateweave-forms",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "pnpm --filter @gateweave/forms-web dev",
		"dev:setup": "pnpm --filter @gateweave/forms-web dev:setup",
		"build": "pnpm -r build",
		"deploy": "pnpm --filter @gateweave/forms-web run deploy",
		"wrangler": "pnpm --filter @gateweave/forms-web exec wrangler --cwd ../..",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test",
		"test:e2e": "pnpm --filter @gateweave/forms-web test:e2e",
		"import:tally": "pnpm --filter @gateweave/forms-tally-import run import",
		"check": "biome check",
		"format": "biome check --write",
		"verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build"
	},
	"cloudflare": {
		"bindings": {
			"DB": {
				"description": "Holds accounts, forms and responses. Choose **Create new** unless you are moving an existing Forms."
			},
			"BETTER_AUTH_SECRET": {
				"description": "Signs the sessions of the people who run forms. Use a long random string, for example from `openssl rand -base64 32`, and keep it secret."
			}
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"typescript": "catalog:"
	}
}
